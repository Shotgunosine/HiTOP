# Apptainer/Singularity definition -- builds the same environment as
# hpc/Dockerfile without needing Docker. Build FROM THE REPO ROOT:
#     apptainer build hitop-cfa.sif hpc/hitop_cfa.def
# (If your cluster disallows local builds, build the Docker image on any
# machine with Docker and convert:  apptainer build hitop-cfa.sif \
#     docker-daemon://hitop-cfa:latest )
Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.69.0

%files
    pixi.toml /opt/hitop/pixi.toml
    pixi.lock /opt/hitop/pixi.lock
    pyproject.toml /opt/hitop/pyproject.toml
    src /opt/hitop/src
    hpc/install_r_libraries.R /opt/hitop/hpc/install_r_libraries.R
    notebooks/run_exhaustive_scale.py /opt/hitop/notebooks/run_exhaustive_scale.py
    notebooks/exploratory_status.py /opt/hitop/notebooks/exploratory_status.py

%post
    cd /opt/hitop
    pixi install --locked
    pixi run Rscript hpc/install_r_libraries.R
    # bake the activation script so NOTHING invokes pixi at runtime
    # (runtime pixi re-verifies the env and writes caches under $HOME,
    # which fails on NFS homes and needs network -- neither exists on
    # HPC compute nodes)
    pixi shell-hook --manifest-path /opt/hitop/pixi.toml > /opt/hitop/activate.sh
    # bash wrapper: %runscript executes under /bin/sh (dash), but the
    # activation scripts (conda activate.d) are bash -- '[[: Permission
    # denied' otherwise
    printf '#!/bin/bash\nset -e\nsource /opt/hitop/activate.sh\ncd /opt/hitop/notebooks\nexec python "$@"\n' > /opt/hitop/run.sh
    chmod +x /opt/hitop/run.sh
    pixi clean cache --yes || true

%environment
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    exec /opt/hitop/run.sh "$@"
